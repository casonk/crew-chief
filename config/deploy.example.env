# Copy to config/deploy.local.env (gitignored) to choose how the listener runs. Nothing here is required:
# without it, deploy/deploy.sh uses "dev". See docs/deployment.md.
#
#   dev   the listener in the foreground: Python only, no systemd, no cluster
#   host  the Clockwork-managed systemd user service crew-chief-listener.service
#   k3s   a pod in K3s with default-deny egress (needs K3s, podman and the in-cluster registry)
CREW_CHIEF_DEPLOY_MODE=dev
