[[jobs]]
name = "crew-chief-listener"
description = "crew-chief shock-relay listener — poll Signal and Gmail for commands"
scope = "user"
service_type = "simple"
working_directory = "__REPO_ROOT__"
exec_start = "__REPO_ROOT__/scripts/run_listener.sh"
after = ["network.target"]
restart = "on-failure"
restart_sec = "5"
standard_output = "journal"
standard_error = "journal"
service_install_wanted_by = ["default.target"]

[jobs.environment]
CREW_CHIEF_LISTENER_CONFIG = "__REPO_ROOT__/config/listener/config.toml"
PYTHONPATH = "__REPO_ROOT__/src"
AUTO_PASS_NOTIFY_PASSWORD_RETRIEVAL_EVERY_N = "3"
