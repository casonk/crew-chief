# config/ollama/config.env.example
# Copy to config/ollama/config.env and adjust values for your local environment.
# This file should NOT be committed; add config.env to .gitignore.

# Port the Ollama REST API listens on inside the container.
OLLAMA_HOST=0.0.0.0:11434

# Maximum number of models to keep loaded in memory simultaneously.
# Lower values reduce RAM usage; set to 1 for single-model workloads.
# OLLAMA_MAX_LOADED_MODELS=1

# GPU acceleration (leave unset to let Ollama auto-detect).
# Set to "0" to force CPU-only mode.
# CUDA_VISIBLE_DEVICES=0
