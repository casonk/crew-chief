# config/listener/config.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY NOTICE
# ─────────────────────────────────────────────────────────────────────────────
# This file is a template.  Copy it to config/listener/config.toml and fill in
# your local values.  config/listener/config.toml is gitignored and must never
# be committed.
#
# Fields that must stay out of version control
# ─────────────────────────────────────────────
#   signal.trusted_senders   — your phone number(s)
#   signal.reply_to          — your phone number
#   signal.shock_relay_dir   — absolute path on this machine
#   signal.config_path       — absolute path on this machine
#   gmail.trusted_senders    — your email address(es)
#   gmail.reply_to           — your email address
#   gmail.shock_relay_dir    — absolute path on this machine
#   gmail.config_path        — absolute path on this machine
#   dispatch.allowed_commands — reveals your permitted command surface
#   agent.allowed_paths      — reveals your permitted filesystem surface
#
# API keys are NOT stored here.  They are read from environment variables.
# See config/env.example for the complete list of required env vars.
#
# Install listener extras before running:
#   pip install "crew-chief[listener]"      # Python 3.10
#   pip install -e .                        # Python 3.11+ (tomllib built-in)
#
# Start the listener:
#   source config/env                       # load API keys into the shell
#   crew-chief listen --config config/listener/config.toml
#
# Or use the managed scripts:
#   bash scripts/start_listener.sh          # background (sources config/env automatically)
#   bash scripts/run_listener.sh            # foreground / systemd  (same)

# ─────────────────────────────────────────────────────────────────────────────
# Listener loop
# ─────────────────────────────────────────────────────────────────────────────
[listener]
# Seconds between full poll cycles.  Signal itself blocks for ~5 s per cycle.
poll_interval_seconds = 30

# ─────────────────────────────────────────────────────────────────────────────
# LLM / provider settings
# ─────────────────────────────────────────────────────────────────────────────
[llm]
# ── Provider selection ───────────────────────────────────────────────────────
# "fallback"   — try each entry in fallback_chain in order (recommended)
# "ollama"     — local Ollama service only
# "claude-cli" — claude CLI only (browser-authenticated, no API key needed)
# "codex-cli"  — codex CLI only  (browser-authenticated, no API key needed)
# "anthropic"  — Anthropic Messages API only (requires ANTHROPIC_API_KEY)
# "openai"     — OpenAI Chat Completions API only (requires OPENAI_API_KEY)
provider = "fallback"

# Ordered provider names tried by FallbackProvider.
# A provider is skipped silently when it is unavailable (service down, CLI not
# installed / not logged in, API key absent or invalid).
fallback_chain = ["ollama", "claude-cli", "codex-cli", "anthropic", "openai"]

# ── Ollama settings ──────────────────────────────────────────────────────────
# Model used by OllamaProvider for both generate and chat calls.
model = "llama3.2"

# Base URL of the running Ollama service.
base_url = "http://localhost:11434"

# Request timeout in seconds (applies to all providers unless overridden below).
timeout_seconds = 60

# When true, natural-language messages are passed through the LLM for command
# extraction.  When false, only messages prefixed with "!" are processed.
# Ignored when agent.enabled = true (agent mode handles its own routing).
natural_language = true

# ── Anthropic API settings ───────────────────────────────────────────────────
# Name of the environment variable that holds the Anthropic API key.
# The key itself must be set in config/env (or exported before starting).
# api_key_env = "ANTHROPIC_API_KEY"

# auto-pass KeePass entry path for the Anthropic API key.
# When set, the key is read from KeePass via the auto-pass CLI if
# ANTHROPIC_API_KEY is not already in the environment.
# Requires the auto-pass repo to be installed and configured.
# api_key_auto_pass_entry = "api-keys/anthropic"

# Upper bound on tokens generated per response (cloud API providers only).
# max_tokens = 4096

# ── OpenAI API settings ──────────────────────────────────────────────────────
# Name of the environment variable that holds the OpenAI API key.
# openai_api_key_env = "OPENAI_API_KEY"

# auto-pass KeePass entry path for the OpenAI API key.
# openai_api_key_auto_pass_entry = "api-keys/openai"

# OpenAI model to use.  Defaults to "gpt-4o".
# openai_model = "gpt-4o"

# ── Claude CLI settings ──────────────────────────────────────────────────────
# Model alias or full ID for the claude CLI.  Empty = CLI default.
# claude_cli_model = ""

# Tool names to allow (e.g. "Bash,Read,Edit,Write").
# Empty string = no tools (pure text generation — safest, fastest for Q&A).
# For code-change requests set to "Bash,Read,Edit,Write" so the CLI can modify files.
# claude_cli_allowed_tools = "Bash,Read,Edit,Write"

# ── Codex CLI settings ───────────────────────────────────────────────────────
# Model name for the codex CLI.  Empty = CLI default (e.g. "o3").
# codex_cli_model = ""

# Sandbox policy for Codex agent tool execution.
# "read-only"          — no writes (safest)
# "workspace-write"    — can write inside the working directory (default)
# "danger-full-access" — unrestricted (not recommended)
# codex_cli_sandbox = "workspace-write"

# ─────────────────────────────────────────────────────────────────────────────
# Agent mode  (multi-step plan → act → observe loop)
# ─────────────────────────────────────────────────────────────────────────────
[agent]
# Set to true to replace the single-command dispatch flow with the Agent loop.
# When enabled, the full message text is passed to the Agent; the model may
# call tools across multiple iterations before producing the final reply.
enabled = false

# Maximum tool-use cycles before the agent returns its last partial response.
# Increase for complex multi-step tasks; lower values reduce runaway cost.
max_iterations = 10

# Built-in tools to make available to the agent.
# "shell"      — run allowlisted shell commands (uses dispatch.allowed_commands)
# "read_file"  — read files within agent.allowed_paths
# "write_file" — write files within agent.allowed_paths
tools = ["shell", "read_file", "write_file"]

# Absolute path prefixes the model may read/write via file tools.
# An empty list means unrestricted — only safe if all paths on the machine
# are acceptable for the model to access.
# SECURITY: always restrict to specific directories in production.
# allowed_paths = ["/home/youruser/projects/myrepo"]
allowed_paths = []

# Override the agent system prompt.  Leave empty to use the built-in default.
# system_prompt = "You are a helpful automation assistant..."

# Agent-specific provider override.
# When set, the agent uses this provider/chain instead of the top-level [llm]
# settings.  Combine with confidence_threshold to keep fast local models first
# while automatically escalating complex tasks to higher-fidelity providers.
# provider = "fallback"
# fallback_chain = ["ollama", "claude-cli", "codex-cli", "anthropic", "openai"]

# Minimum self-assessed confidence (0.0–1.0) required to accept a response.
# After the agent loop completes, the model is asked to rate how well it
# addressed the request.  Scores below this threshold trigger escalation to
# the next provider in fallback_chain.  0.0 disables the check entirely.
# confidence_threshold = 0.7

# Per-agent-request timeout in seconds (overrides llm.timeout_seconds).
# Agent tasks involve multiple LLM calls plus file I/O and CLI execution,
# so they need a much longer timeout than a single-shot query.
# 0 = inherit llm.timeout_seconds.
# timeout_seconds = 300

# ─────────────────────────────────────────────────────────────────────────────
# Signal channel
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: trusted_senders and reply_to contain real phone numbers.
#           shock_relay_dir and config_path are absolute paths on this machine.
#           None of these should appear in version control.
[signal]
enabled = false

# Absolute path to the shock-relay services/signal-cli directory.
shock_relay_dir = "/path/to/shock-relay/services/signal-cli"

# Path to the signal-cli config.local.yaml used by shock-relay.
config_path = "/path/to/shock-relay/services/signal-cli/config.local.yaml"

# Phone numbers allowed to send commands.  Messages from any other number are
# silently discarded before any LLM or dispatch processing.
trusted_senders = ["+15551234567"]

# Phone number replies are sent to (usually your own Signal number).
reply_to = "+15551234567"

# ─────────────────────────────────────────────────────────────────────────────
# Gmail channel
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: trusted_senders and reply_to contain real email addresses.
#           shock_relay_dir and config_path are absolute paths on this machine.
#           None of these should appear in version control.
[gmail]
enabled = false

# Absolute path to the shock-relay services/gmail-imap directory.
shock_relay_dir = "/path/to/shock-relay/services/gmail-imap"

# Path to the gmail-imap config.local.yaml used by shock-relay.
config_path = "/path/to/shock-relay/services/gmail-imap/config.local.yaml"

# Email addresses allowed to send commands.  All other senders are discarded.
trusted_senders = ["you@example.com"]

# Address replies are sent to.
reply_to = "you@example.com"

# Only scan messages received within the last N days on each poll cycle.
since_days = 1

# Maximum unseen messages to fetch per poll cycle.
limit = 5

# ─────────────────────────────────────────────────────────────────────────────
# Command dispatch  (shell tool and single-command mode)
# ─────────────────────────────────────────────────────────────────────────────
# SECURITY: allowed_commands defines what the LLM (or a remote sender) can run
#           on this machine.  Treat this list as an explicit attack surface.
#           Every pattern here is a command a trusted sender can execute.
#           Use the most specific globs possible.  Avoid "rm*", "sudo*", "*".
[dispatch]
# Hard timeout per command in seconds.
timeout_seconds = 30

# Maximum output bytes in the reply.  Long output is truncated with a notice.
output_max_bytes = 2000

# fnmatch-style globs matched against the full command string.
# The command must match at least one pattern before any subprocess is launched.
# Start with the minimum set you actually need and expand deliberately.
allowed_commands = [
  "df*",
  "free*",
  "uptime",
  "hostname",
  "date",
  "ping -c *",
  "ls *",
  "uname*",
  "whoami",
  # Uncomment with care — these reveal more system state:
  # "systemctl status *",
  # "journalctl -n *",
  # "ps aux",
]
