{
  "name": "clockwork-listen-category",
  "description": "Sort an item into a Clockwork To Listen category. Names are well-known public works and generic descriptions, not entries from any real list. Baseline rules were written against the dev split only.",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which To Listen category does this item belong to?",
      "criteria": {
        "Albums": "A music album or record",
        "Podcasts": "A recurring spoken-word audio show",
        "Audiobooks": "A book narrated in audio form",
        "Radio": "A radio station, stream or broadcast",
        "Artists": "A musician or band to explore, with no specific album named"
      }
    }
  },
  "baseline": {
    "category": {
      "default": "Artists",
      "rules": [
        {
          "if_any": [
            "(album)",
            "blue",
            "computer"
          ],
          "then": "Albums"
        },
        {
          "if_any": [
            "podcast",
            "history",
            "money"
          ],
          "then": "Podcasts"
        },
        {
          "if_any": [
            "audiobook",
            "narrated",
            "(audio)"
          ],
          "then": "Audiobooks"
        },
        {
          "if_any": [
            "stream",
            "radio",
            "fm"
          ],
          "then": "Radio"
        }
      ]
    }
  },
  "items": [
    {
      "state": "Abbey Road (album)",
      "expected": {
        "category": "Albums"
      }
    },
    {
      "state": "Kind of Blue",
      "expected": {
        "category": "Albums"
      }
    },
    {
      "state": "OK Computer",
      "expected": {
        "category": "Albums"
      }
    },
    {
      "state": "Radiolab podcast",
      "expected": {
        "category": "Podcasts"
      }
    },
    {
      "state": "Hardcore History",
      "expected": {
        "category": "Podcasts"
      }
    },
    {
      "state": "Planet Money",
      "expected": {
        "category": "Podcasts"
      }
    },
    {
      "state": "Project Hail Mary audiobook",
      "expected": {
        "category": "Audiobooks"
      }
    },
    {
      "state": "Dune, narrated by Scott Brick",
      "expected": {
