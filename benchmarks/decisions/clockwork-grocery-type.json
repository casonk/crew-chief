{
  "name": "clockwork-grocery-type",
  "description": "Sort a grocery list item into its grocery type, as Clockwork's AI categorize does for the groceries list. Item names are generic and synthetic. Baseline rules were written against the dev split only.",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which grocery type does this item belong to?",
      "criteria": {
        "Meat": "Beef, pork, poultry, lamb, sausage and deli meat",
        "Seafood": "Fish, shellfish and other seafood",
        "Produce": "Fresh fruit, vegetables and herbs",
        "Dairy": "Milk, cheese, yogurt, butter, cream and eggs",
        "Bakery": "Bread, rolls, tortillas, pastries and baked goods",
        "Beverages": "Non-alcoholic drinks: water, juice, soda, coffee, tea",
        "Spirits": "Alcoholic drinks: beer, wine and liquor",
        "Spices": "Dried spices, seasoning blends and dried herbs",
        "Condiments": "Sauces, dressings, spreads and jarred toppings",
        "Pantry": "Shelf-stable staples: rice, pasta, flour, canned goods, oils",
        "Snacks": "Chips, crackers, candy, nuts, bars and cookies",
        "Frozen": "Frozen meals, vegetables, fruit and ice cream"
      }
    }
  },
  "baseline": {
    "category": {
      "default": "Produce",
      "rules": [
        {
          "if_any": [
            "turkey",
            "pork",
            "sausage",
            "chicken",
            "beef"
          ],
          "then": "Meat"
        },
        {
          "if_any": [
            "salmon",
            "shrimp",
            "tuna"
          ],
          "then": "Seafood"
        },
        {
          "if_any": [
            "milk",
            "cheese",
            "yogurt",
            "butter",
            "egg"
          ],
          "then": "Dairy"
        },
        {
          "if_any": [
            "frozen",
            "ice cream",
            "pizza"
          ],
          "then": "Frozen"
        },
        {
          "if_any": [
            "loaf",
            "tortillas",
            "croissant",
            "bread"
          ],
          "then": "Bakery"
        },
        {
          "if_any": [
            "juice",
            "water",
            "coffee",
            "tea"
          ],
          "then": "Beverages"
        },
        {
          "if_any": [
            "ipa",
            "noir",
            "bourbon",
            "wine",
            "beer"
          ],
          "then": "Spirits"
        },
        {
          "if_any": [
            "paprika",
            "cumin",
            "seasoning"
          ],
          "then": "Spices"
        },
        {
          "if_any": [
            "ketchup",
            "dressing",
            "peanut butter"
          ],
          "then": "Condiments"
        },
        {
          "if_any": [
            "rice",
            "spaghetti",
            "oil"
          ],
          "then": "Pantry"
        },
        {
          "if_any": [
            "chips",
            "trail mix",
            "chocolate"
          ],
          "then": "Snacks"
        }
      ]
    }
  },
