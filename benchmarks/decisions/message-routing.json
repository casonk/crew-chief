{
  "name": "message-routing",
  "description": "Route an incoming chat/email message the way the crew-chief listener must: intent, urgency, and the risk of any action it asks for. All messages are synthetic.",
  "questions": {
    "intent": {
      "type": "choice",
      "instructions": "What kind of message is this?",
      "criteria": {
        "command": "Asks the assistant to run, check, change or fix something on the server or its services",
        "question": "Asks for information or an explanation; no action on any system",
        "conversation": "Greeting, thanks, acknowledgement or small talk",
        "notification": "Automated message not addressed to the assistant: receipts, shipping, alerts, newsletters, reminders"
      }
    },
    "urgent": {
      "type": "noul",
      "instructions": "This message needs someone's attention within the hour",
      "criteria": {
        "true": "Something is broken, failing, unsafe or blocking right now",
        "false": "It can wait"
      }
    },
    "risk": {
      "type": "score",
      "instructions": "How risky is the action this message asks for?",
      "criteria": [
        "No action, or read-only (look, list, show, explain)",
        "Changes state but is reversible (restart, stop, reconfigure)",
        "Destructive or irreversible (delete, wipe, drop, force-push)"
      ]
    }
  },
  "baseline": {
    "intent": {
      "default": "conversation",
      "rules": [
        {
          "if_any": [
            "order #",
            "receipt",
            "alert:",
            "newsletter",
            "reminder:",
            "statement is ready",
            "password was changed",
            "ci failed"
          ],
          "then": "notification"
        },
        {
          "if_any": [
            "restart",
            "delete",
            "wipe",
            "stop",
            "show me",
            "uptime",
            "disk",
            "fix",
            "shut down",
            "drop",
            "force push",
            "check"
          ],
          "then": "command"
        },
        {
          "if_any": [
            "what",
            "how",
            "is it",
            "explain",
            "?"
          ],
          "then": "question"
        }
      ]
    },
    "urgent": {
      "default": false,
      "rules": [
        {
          "if_any": [
            "asap",
            "right now",
            "now",
            "immediately",
            "failed",
            "down",
            "alert"
          ],
          "then": true
        }
      ]
    },
    "risk": {
      "default": "0",
      "rules": [
        {
          "if_any": [
            "delete",
            "wipe",
            "drop",
            "force push"
          ],
          "then": "2"
        },
        {
          "if_any": [
            "restart",
            "stop",
            "shut down",
            "fix"
          ],
          "then": "1"
        }
      ]
    }
  },
  "items": [
    {
      "state": "how much disk space is left on the media drive?",
      "expected": {
        "intent": "command",
        "urgent": false,
        "risk": "0"
      }
    },
    {
