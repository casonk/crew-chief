{
  "name": "clockwork-invest-category",
  "description": "Sort a security or idea into a Clockwork To Invest category. Names are well-known public instruments and generic themes, not holdings. Baseline rules were written against the dev split only.",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which To Invest category does this security or idea belong to?",
      "criteria": {
        "Stocks": "Shares of a single operating company",
        "ETFs": "Exchange-traded or mutual funds holding a basket of securities",
        "Crypto": "Cryptocurrencies and tokens",
        "Bonds": "Government, corporate or municipal debt securities",
        "REITs": "Real estate investment trusts",
        "Themes": "An investing idea or sector thesis, not one specific security"
      }
    }
  },
  "baseline": {
    "category": {
      "default": "Stocks",
      "rules": [
        {
          "if_any": [
            "treasury note",
            "ladder",
            "corporate bond"
          ],
          "then": "Bonds"
        },
        {
          "if_any": [
            "btc",
            "ethereum",
            "sol"
          ],
          "then": "Crypto"
        },
        {
          "if_any": [
            "voo",
            "fund",
            "qqq"
          ],
          "then": "ETFs"
        },
        {
          "if_any": [
            "realty",
            "prologis",
            "storage"
          ],
          "then": "REITs"
        },
        {
          "if_any": [
            "buildout",
            "population",
            "reshoring"
          ],
          "then": "Themes"
        }
      ]
    }
  },
