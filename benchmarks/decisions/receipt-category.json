{
  "name": "receipt-category",
  "description": "Categorize a receipt line and tell whether the charge recurs. All merchants and amounts are synthetic. Baseline rules were written against the dev split only.",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which spending category does this receipt line belong to?",
      "criteria": {
        "groceries": "Food and household supplies bought to take home",
        "dining": "Restaurants, cafes, bars and takeaway meals",
        "transport": "Fuel, transit, parking, rideshare and vehicle costs",
        "utilities": "Electricity, water, internet, phone and similar services",
        "entertainment": "Streaming, games, events, hobbies and subscriptions for fun",
        "health": "Pharmacy, clinic, dental and fitness costs"
      }
    },
    "recurring": {
      "type": "noul",
      "instructions": "This charge repeats on a regular schedule",
      "criteria": {
        "true": "A subscription, bill or membership charged every period",
        "false": "A one-off purchase"
      }
    }
  },
  "baseline": {
    "category": {
      "default": "groceries",
      "rules": [
        {
          "if_any": [
            "pharmacy",
            "dental",
            "fitness",
            "clinic",
            "prescription"
          ],
          "then": "health"
        },
        {
          "if_any": [
            "transit",
            "fuel",
            "garage",
            "park",
            "unleaded"
          ],
          "then": "transport"
        },
        {
          "if_any": [
            "electric",
            "internet",
            "wireless"
          ],
          "then": "utilities"
        },
        {
          "if_any": [
            "streamly",
            "game",
            "arcade"
          ],
          "then": "entertainment"
        },
        {
          "if_any": [
            "cafe",
            "pizza",
            "bakery",
            "dinner"
          ],
          "then": "dining"
        }
      ]
    },
    "recurring": {
      "default": false,
      "rules": [
        {
          "if_any": [
            "monthly",
            "membership",
            "electric",
            "internet",
            "wireless",
            "pass"
          ],
          "then": true
        }
      ]
    }
  },
  "items": [
    {
      "state": "GREENLEAF MARKET #12 AUSTIN  PRODUCE 18.42",
      "expected": {
        "category": "groceries",
        "recurring": false
      }
    },
    {
      "state": "COPPER KETTLE CAFE  LATTE + SCONE 9.80",
      "expected": {
        "category": "dining",
        "recurring": false
      }
    },
    {
      "state": "CITY TRANSIT  MONTHLY PASS 64.00",
      "expected": {
        "category": "transport",
        "recurring": true
      }
    },
    {
