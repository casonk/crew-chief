{
  "name": "clockwork-read-category",
  "description": "Sort an item into a Clockwork To Read category. Titles are generic or well-known public works, not entries from any real list. Baseline rules were written against the dev split only.",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which To Read category does this item belong to?",
      "criteria": {
        "Books": "A full-length book, fiction or non-fiction",
        "Articles": "A magazine, newspaper, blog or web article",
        "Papers": "An academic or technical research paper",
        "Comics": "A comic book, graphic novel or manga volume"
      }
    }
  },
  "baseline": {
    "category": {
      "default": "Books",
      "rules": [
        {
          "if_any": [
            "frank herbert",
            "pragmatic",
            "educated"
          ],
          "then": "Books"
        },
        {
          "if_any": [
            "longread",
            "blog post",
            "new yorker"
          ],
          "then": "Articles"
        },
        {
          "if_any": [
            "attention",
            "usenix",
            "arxiv"
          ],
          "then": "Papers"
        },
        {
          "if_any": [
            "maus",
            "saga",
            "berserk"
          ],
          "then": "Comics"
        }
      ]
    }
  },
  "items": [
