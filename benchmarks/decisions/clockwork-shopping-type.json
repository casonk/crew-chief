{
  "name": "clockwork-shopping-type",
  "description": "Sort a shopping list item into its consumer-goods type, as Clockwork's AI categorize does for the shopping list. Item names are generic and synthetic. Baseline rules were written against the dev split only.",
  "questions": {
    "category": {
      "type": "choice",
      "instructions": "Which consumer-goods type does this item belong to?",
      "criteria": {
        "Tops": "Shirts, sweaters, hoodies and blouses",
        "Bottoms": "Pants, jeans, shorts, skirts and leggings",
        "Outerwear": "Coats, jackets, rain shells and vests",
        "Footwear": "Shoes, boots, sandals and slippers",
        "Accessories": "Belts, hats, scarves, bags, watches and jewelry",
        "Underwear": "Underwear, socks and base layers",
        "Bedding": "Sheets, pillows, blankets and comforters",
        "Bath": "Towels, shower curtains and bath mats",
        "Cleaning": "Cleaning supplies, brooms, mops and detergents",
        "Lighting": "Lamps, bulbs and light fixtures",
        "Storage": "Bins, shelves, hangers and organizers",
        "Furniture": "Chairs, tables, desks, sofas and bed frames",
        "Fitness": "Gym equipment, yoga gear and weights",
        "Camping": "Tents, sleeping bags, stoves and trail gear",
        "Sports": "Balls, rackets, bats and other sport equipment",
        "Electronics": "Chargers, headphones, cables, speakers and gadgets"
      }
    }
  },
  "baseline": {
    "category": {
      "default": "Electronics",
      "rules": [
        {
          "if_any": [
            "sweater",
            "shirt"
          ],
          "then": "Tops"
        },
        {
          "if_any": [
            "jeans",
            "shorts"
          ],
          "then": "Bottoms"
        },
        {
          "if_any": [
            "shell",
            "vest"
          ],
          "then": "Outerwear"
        },
        {
          "if_any": [
            "runners",
            "boots"
          ],
          "then": "Footwear"
        },
        {
          "if_any": [
            "beanie",
            "belt"
          ],
          "then": "Accessories"
        },
        {
          "if_any": [
            "socks",
            "briefs"
          ],
          "then": "Underwear"
        },
        {
          "if_any": [
            "sheet",
            "pillow"
          ],
          "then": "Bedding"
        },
        {
          "if_any": [
            "towel",
            "curtain"
          ],
          "then": "Bath"
        },
        {
          "if_any": [
            "detergent",
            "mop"
          ],
          "then": "Cleaning"
        },
        {
          "if_any": [
            "bulb",
            "lamp"
          ],
          "then": "Lighting"
        },
        {
          "if_any": [
            "bins",
            "hangers"
          ],
          "then": "Storage"
        },
        {
          "if_any": [
            "desk",
            "chair"
          ],
          "then": "Furniture"
        },
        {
          "if_any": [
            "yoga",
            "dumbbell"
          ],
          "then": "Fitness"
        },
        {
          "if_any": [
            "tent",
            "stove"
          ],
          "then": "Camping"
        },
        {
          "if_any": [
            "basketball",
            "racket"
          ],
          "then": "Sports"
        }
      ]
    }
  },
